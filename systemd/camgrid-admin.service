# CamGrid - admin server (management interface and JSON API)
# __DIENSTBENUTZER__, __DIENSTGRUPPE__ and __PYTHON__ are replaced by install.sh.
[Unit]
Description=CamGrid admin server
Documentation=file:///opt/camgrid
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__DIENSTBENUTZER__
Group=__DIENSTGRUPPE__
WorkingDirectory=/opt/camgrid
Environment=PYTHONUNBUFFERED=1
ExecStart=__PYTHON__ /opt/camgrid/app/server.py --config /etc/camgrid/config.json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=camgrid-admin

[Install]
WantedBy=multi-user.target
