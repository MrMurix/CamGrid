# CamGrid - streaming service (go2rtc) with the display page on port 1984
# __DIENSTBENUTZER__, __DIENSTGRUPPE__ and __PYTHON__ are replaced by install.sh.
# ExecStartPre creates /var/lib/camgrid/go2rtc.yaml from the configuration.
[Unit]
Description=CamGrid streaming service (go2rtc)
Documentation=https://github.com/AlexxIT/go2rtc
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__DIENSTBENUTZER__
Group=__DIENSTGRUPPE__
WorkingDirectory=/var/lib/camgrid
Environment=PYTHONUNBUFFERED=1
ExecStartPre=__PYTHON__ /opt/camgrid/app/streams.py
ExecStart=/opt/camgrid/bin/go2rtc -config /var/lib/camgrid/go2rtc.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=camgrid-go2rtc

[Install]
WantedBy=multi-user.target
